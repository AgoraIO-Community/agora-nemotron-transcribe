# Agora CLI: agora quickstart env write . --template nextjs --scenario voice-agent --project YOUR_PROJECT
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=

# Free community demo; no GPU server or paid fallback.
NEMOTRON_PROVIDER=hf-space
# Optional server-side token from your free Hugging Face account.
# Without it, requests use the server’s shared anonymous quota.
HF_TOKEN=

# Optional self-hosted route: change NEMOTRON_PROVIDER to vllm.
# NeMo Speech + vLLM chat-completions base, not the full endpoint path.
# Leave empty until inference is ready. A local SSH tunnel is supported.
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B
# Optional, only if your inference server requires a Bearer key.
NEMOTRON_API_KEY=

# Optional documented MiniMax Hindi system voice override:
AGORA_HOST_VOICE=hindi_female_1_v2

# Optional language-specific MiniMax host voices:
AGORA_HOST_VOICE_HI=hindi_female_1_v2
AGORA_HOST_VOICE_EN=English_Aussie_Bloke
